term = xterm-256color

font-family = UDEV Gothic NF
font-family = Noto Color Emoji
font-size = 22
theme = Afterglow
background-opacity = 0.99
window-padding-x = 0
window-padding-y = 0
window-width = 170
window-height = 48
window-show-tab-bar = auto

# Keep application keys available except clipboard, font size, and palette actions.
keybind = clear
# Copies Ghostty's selection, not Herdr's copy-mode selection.
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = f12=toggle_command_palette
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1

# Shift + mouse drag selects in Ghostty even when the application captures mice.
mouse-shift-capture = never
