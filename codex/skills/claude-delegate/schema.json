{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "findings", "next_steps", "blockers"],
  "properties": {
    "status": { "type": "string", "enum": ["done", "partial", "blocked"] },
    "summary": { "type": "string", "maxLength": 600, "description": "What was done and the outcome." },
    "changed_files": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 }, "description": "Repo-relative paths written. Empty array for read-only runs." },
    "findings": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 }, "description": "Facts established, one line each. Cite file:line where applicable." },
    "next_steps": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "blockers": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 }, "description": "Empty array when status is done." }
  }
}
