{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/outward-write-readback.sh'",
            "statusMessage": "投稿された実物を取得中...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/git-push-guard.sh'",
            "statusMessage": "git push ガード確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/reboot-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/reboot-guard.sh'",
            "statusMessage": "OS 再起動の明示許可を確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/control-loss-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/control-loss-guard.sh'",
            "statusMessage": "操作不能化の明示許可を確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/overengineering-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/overengineering-gate.sh'",
            "statusMessage": "過剰テストゲート確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/gh-body-file-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/gh-body-file-guard.sh'",
            "statusMessage": "gh の本文受け渡しを確認中...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/overengineering-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/overengineering-gate.sh'",
            "statusMessage": "過剰テストゲート確認中...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "apply_patch|Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/herdr-skill-nudge.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/herdr-skill-nudge.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/git-push-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/reboot-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/reboot-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/control-loss-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/control-loss-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
