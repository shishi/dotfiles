{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/outward-write-readback.sh'",
            "statusMessage": "投稿された実物を取得中...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex record",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex record'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "collaborationspawn_agent|collaborationfollowup_task|collaborationinterrupt_agent|collaborationwait_agent"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/output-gate-codex.sh pre-compact",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/output-gate-codex.sh pre-compact'",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "PreModelRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.agent-shared/hooks/output-gate-codex.sh pre-model",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/output-gate-codex.sh pre-model'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/command-judge.sh --cli codex",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/command-judge.sh --cli codex'",
            "statusMessage": "コマンドの影響を判定中...",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex pre-wait",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex pre-wait'",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "collaborationwait_agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/herdr-skill-nudge.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/herdr-skill-nudge.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "commandWindows": "& (Join-Path $HOME '.codex/herdr-agent-state.ps1') session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/output-gate-codex.sh session-start",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/output-gate-codex.sh session-start'",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/output-gate-codex.sh stop",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/output-gate-codex.sh stop'",
            "timeout": 15,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex stop-check",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex stop-check'",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex subagent-start",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex subagent-start'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex subagent-stop",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex subagent-stop'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/command-judge.sh --cli codex --record-prompt",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/command-judge.sh --cli codex --record-prompt'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory lookup",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory lookup'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/output-gate-codex.sh prompt",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/output-gate-codex.sh prompt'",
            "timeout": 15,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/stall-guard.sh --cli codex inject",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/stall-guard.sh --cli codex inject'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
