{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/hooks/git-push-guard.sh",
            "commandWindows": "& 'C:/Users/shishi/scoop/apps/git/current/bin/bash.exe' -c '~/.codex/hooks/git-push-guard.sh'",
            "timeout": 10,
            "statusMessage": "git push ガード確認中..."
          }
        ]
      }
    ]
  }
}
