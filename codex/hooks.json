{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agents/hooks/git-push-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/git-push-guard.sh'",
            "statusMessage": "git push ガード確認中...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 10000,
            "command": "bash ~/.agents/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.codex/herdr-agent-state.sh session'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.agents/hooks/git-push-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/git-push-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
