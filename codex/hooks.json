{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/outward-write-readback.sh'",
            "statusMessage": "投稿された実物を取得中...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/git-push-guard.sh'",
            "statusMessage": "git push ガード確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/overengineering-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/overengineering-gate.sh'",
            "statusMessage": "過剰テストゲート確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/convergence-gate.sh'",
            "statusMessage": "収束ゲート確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/doc-no-narrative.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/doc-no-narrative.sh'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/shigenobu.407/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-necessity-gate.sh stop",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-necessity-gate.sh stop'",
            "statusMessage": "依頼と差分の必要性を確認中...",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/git-push-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/enforce-continuation.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/enforce-continuation.sh'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/task-necessity-gate.sh start",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-necessity-gate.sh start'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/convergence-gate.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
