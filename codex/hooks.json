{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/outward-write-readback.sh'",
            "statusMessage": "投稿された実物を取得中...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh post-bash",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh post-bash'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "additionalContextLimit": 5000,
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh post-wait",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh post-wait'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "collaborationwait_agent"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh post-followup",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh post-followup'",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "collaborationfollowup_task"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh post-close",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh post-close'",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "collaborationclose_agent|collaborationinterrupt_agent"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh pre-bash",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh pre-bash'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh pre-wait",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh pre-wait'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "collaborationwait_agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/herdr-skill-nudge.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/herdr-skill-nudge.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/kata-entry.sh",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/kata-entry.sh'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh stop",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh stop'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/kata-completion.sh codex",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/kata-completion.sh codex'",
            "statusMessage": "計画の完了を確認中...",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh subagent-start",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh subagent-start'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh subagent-stop",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh subagent-stop'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory lookup",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/inject-memory.sh ~/.codex/memory lookup'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.agent-shared/hooks/task-monitor-codex.sh prompt",
            "commandWindows": "& (Join-Path $HOME '.agent-shared/bin/invoke-git-bash-hook.ps1') '~/.agent-shared/hooks/task-monitor-codex.sh prompt'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
