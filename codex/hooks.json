{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agents/hooks/git-push-guard.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/git-push-guard.sh'",
            "statusMessage": "git push ガード確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agents/hooks/overengineering-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/overengineering-gate.sh'",
            "statusMessage": "過剰テストゲート確認中...",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agents/hooks/convergence-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/convergence-gate.sh'",
            "statusMessage": "収束ゲート確認中...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 30000,
            "command": "bash ~/.agents/hooks/inject-memory.sh ~/.codex/memory",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/inject-memory.sh ~/.codex/memory'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $HOME '.codex/herdr-agent-state.ps1') session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.agents/hooks/git-push-guard.sh --record-approval",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/git-push-guard.sh --record-approval'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agents/hooks/enforce-continuation.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/enforce-continuation.sh'",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.agents/hooks/convergence-gate.sh",
            "commandWindows": "& (Join-Path $HOME '.agents/bin/invoke-git-bash-hook.ps1') '~/.agents/hooks/convergence-gate.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
