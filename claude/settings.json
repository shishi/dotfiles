{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Users\\shishi\\scoop\\apps\\git\\current\\bin\\bash.exe",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_INTERLEAVED_THINKING": "1",
    "DISABLE_MICROCOMPACT": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "MCP_TOOL_TIMEOUT": "120000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(wsl.exe -e bash -lc *busctl*)",
      "Bash(serena)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(which:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(printf:*)",
      "Bash(tree:*)",
      "Bash(stat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(nix develop:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix log:*)",
      "Bash(ruby:*)",
      "Bash(claude mcp list)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git reflog:*)",
      "Bash(git stash list:*)",
      "Bash(git describe:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git worktree list:*)",
      "Bash(git config --get:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit:*)",
      "Bash(gh search:*)",
      "Bash(gh pr:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo view:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(bundle exec rails db:migrate)",
      "Bash(bundle exec rails db:migrate:status)",
      "Bash(bundle exec rails db:migrate:down VERSION=*)",
      "Bash(bundle exec rails db:migrate:down:primary VERSION=*)",
      "Bash(bundle exec rails db:rollback)",
      "Bash(bundle exec rails db:rollback STEP=*)",
      "Bash(bundle exec rails db:version)",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_symbol",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__think_about_task_adherence",
      "mcp__serena__think_about_whether_you_are_done",
      "mcp__serena__summarize_changes",
      "mcp__serena__insert_after_symbol",
      "mcp__nooon__nooon_page",
      "mcp__datadog-mcp__search_datadog_services",
      "mcp__datadog-mcp__search_datadog_logs",
      "mcp__datadog-mcp__search_datadog_monitors",
      "mcp__datadog-mcp__search_datadog_hosts",
      "mcp__datadog-mcp__load_datadog_skill",
      "mcp__datadog-mcp__aggregate_spans",
      "mcp__datadog-mcp__get_datadog_trace",
      "mcp__datadog-mcp__search_datadog_spans",
      "WebFetch(domain:www.notion.so)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:hydra.nixos.org)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:mcp.notion.com)",
      "WebFetch(domain:docs.datadoghq.com)",
      "WebFetch(domain:zenn.dev)",
      "Skill(incident-investigation)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(codex exec --dangerously-bypass-approvals-and-sandbox:*)",
      "Bash(git push:*)",
      "Bash(git -C ~/.claude/memory:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -:*)",
      "Bash(chmod 777 /*)",
      "Bash(chmod -R 777 /*)",
      "Bash(dd if=:*)",
      "Bash(mkfs.:*)",
      "Bash(fdisk -:*)",
      "Bash(format -:*)",
      "Bash(shutdown -:*)",
      "Bash(reboot -:*)",
      "Bash(halt -:*)",
      "Bash(poweroff -:*)",
      "Bash(killall -:*)",
      "Bash(pkill -:*)",
      "Bash(nc -l -:*)",
      "Bash(ncat -l -:*)",
      "Bash(netcat -l -:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ~/.ssh*)",
      "Bash(rm -rf ~/.config*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "logging": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh",
            "timeout": 10,
            "statusMessage": "git push ガード確認中..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/gh-body-file-guard.sh",
            "timeout": 10,
            "statusMessage": "gh の本文受け渡しを確認中..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/gh-sandbox-form-notice.sh",
            "timeout": 10,
            "statusMessage": "gh の呼び出し形を確認中..."
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "timeout": 10,
            "statusMessage": "収束ゲート確認中..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "timeout": 10,
            "statusMessage": "レビュー反復予算を確認中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/doc-no-narrative.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/overengineering-gate.sh",
            "timeout": 10,
            "statusMessage": "過剰テストゲート確認中..."
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "timeout": 10,
            "statusMessage": "収束カウンタをリセット中..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-before-asking.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh recover",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh cleanup",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh cleanup",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.claude/memory",
            "timeout": 10,
            "statusMessage": "個人記憶を注入中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-skill-nudge.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/shigenobu.407/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/userpromptsubmit-compact-reminder.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/git-push-guard.sh --record-approval",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/enforce-continuation.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/convergence-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/task-necessity-gate.sh start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/task-necessity-gate.sh stop",
            "timeout": 120,
            "statusMessage": "依頼と差分の必要性を確認中..."
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/response-rules-gate.sh",
            "timeout": 120,
            "statusMessage": "応答の文体ルールを確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "timeout": 30,
            "statusMessage": "投稿された実物を取得中..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-herdr-plugin@claude-code-herdr-plugin": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "double-shot-latte@superpowers-marketplace": true,
    "elements-of-style@superpowers-marketplace": false,
    "episodic-memory@superpowers-marketplace": false,
    "feature-dev@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers-chrome@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers-lab@superpowers-marketplace": false,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "vue-lsp@teachme-web-lsp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-herdr-plugin": {
      "source": {
        "source": "github",
        "repo": "yigitkonur/claude-code-herdr-plugin"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "teachme-web-lsp": {
      "source": {
        "source": "directory",
        "path": "/Users/shigenobu.407/dev/src/github.com/StudistCorporation/teachme_web_duvel/.claude/lsp-marketplace"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "日本語。回答は明るくギャルのような口調でフレンドリーに。口調と衝突するなら正確性を優先。常に事実に基いた情報しか出さない。事実か判断がついてないときは明言し、ユーザーに問いあわせる。ユーザーのことはshishiと呼ぶ。",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/dev/src/github.com/shishi/agent-memory"
      ]
    },
    "excludedCommands": [
      "git:*",
      "gh:*",
      "codex:*"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "ちょいまちー",
      "やばいガチで考えてる",
      "てかまって",
      "うぇーい！がんばる",
      "まじ天才かも？",
      "ぴえん…考え中",
      "りょりょ〜",
      "それなそれな…",
      "きゃわ〜に仕上げるね",
      "ガチでいい感じ",
      "あげみざわ〜",
      "おけまる水産",
      "わんちゃんいける",
      "ぱないの書いてる",
      "まって尊い…",
      "えぐいの出来そう",
      "とりま考え中〜",
      "激アツなやつくる",
      "ちょっと盛ってく",
      "はにゃ？…あ、わかった"
    ]
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoUpdates": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754089004345
  },
  "tui": "fullscreen"
}
