{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "300000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Users\\shishi\\scoop\\apps\\git\\current\\bin\\bash.exe",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "DISABLE_AUTOUPDATER": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_INTERLEAVED_THINKING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "MCP_TOOL_TIMEOUT": "120000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(wsl.exe -e bash -lc *busctl*)",
      "Bash(serena)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(which:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(printenv:*)",
      "Bash(printf:*)",
      "Bash(tree:*)",
      "Bash(stat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(nix develop:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix log:*)",
      "Bash(claude mcp list)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git reflog:*)",
      "Bash(git stash list:*)",
      "Bash(git describe:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git worktree list:*)",
      "Bash(git config --get:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit:*)",
      "Bash(gh search:*)",
      "Bash(gh pr:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo view:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker images:*)",
      "Bash(bundle exec rails db:migrate)",
      "Bash(bundle exec rails db:migrate:status)",
      "Bash(bundle exec rails db:migrate:down VERSION=*)",
      "Bash(bundle exec rails db:migrate:down:primary VERSION=*)",
      "Bash(bundle exec rails db:rollback)",
      "Bash(bundle exec rails db:rollback STEP=*)",
      "Bash(bundle exec rails db:version)",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_symbol",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__think_about_task_adherence",
      "mcp__serena__think_about_whether_you_are_done",
      "mcp__serena__summarize_changes",
      "mcp__serena__insert_after_symbol",
      "mcp__nooon__nooon_page",
      "mcp__datadog-mcp__search_datadog_services",
      "mcp__datadog-mcp__search_datadog_logs",
      "mcp__datadog-mcp__search_datadog_monitors",
      "mcp__datadog-mcp__search_datadog_hosts",
      "mcp__datadog-mcp__load_datadog_skill",
      "mcp__datadog-mcp__aggregate_spans",
      "mcp__datadog-mcp__get_datadog_trace",
      "mcp__datadog-mcp__search_datadog_spans",
      "WebFetch(domain:www.notion.so)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:hydra.nixos.org)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:mcp.notion.com)",
      "WebFetch(domain:docs.datadoghq.com)",
      "WebFetch(domain:zenn.dev)",
      "Skill(incident-investigation)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(codex exec -s read-only:*)",
      "Bash(codex exec -s workspace-write:*)",
      "Bash(git -C ~/.claude/memory:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/gh-sandbox-form-notice.sh",
            "timeout": 10,
            "statusMessage": "gh の呼び出し形を確認中..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh recover",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh cleanup",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-compaction-recovery.sh cleanup",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.claude/memory core",
            "timeout": 20,
            "statusMessage": "個人記憶を同期・注入中..."
          },
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.claude/memory project",
            "timeout": 10,
            "statusMessage": "プロジェクト記憶を注入中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/herdr-skill-nudge.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$OS\" = Windows_NT ]; then if [ \"${HERDR_ENV:-}\" = 1 ]; then powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/hooks/herdr-agent-state.ps1\" session; fi; else bash ~/.claude/hooks/herdr-agent-state.sh session; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/kata-entry.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/userpromptsubmit-compact-reminder.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/inject-memory.sh ~/.claude/memory lookup",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/outward-write-readback.sh",
            "timeout": 30,
            "statusMessage": "投稿された実物を取得中..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/permission-judge.sh",
            "timeout": 90,
            "statusMessage": "確認が必要な操作を判定中...",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/task-monitor-claude.sh",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.agent-shared/hooks/kata-completion.sh claude",
            "timeout": 120,
            "statusMessage": "計画の完了を確認中..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-herdr-plugin@claude-code-herdr-plugin": false,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "double-shot-latte@superpowers-marketplace": false,
    "elements-of-style@superpowers-marketplace": false,
    "episodic-memory@superpowers-marketplace": false,
    "feature-dev@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers-chrome@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers-lab@superpowers-marketplace": false,
    "superpowers@superpowers-marketplace": false,
    "typescript-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "vue-lsp@teachme-web-lsp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-herdr-plugin": {
      "source": {
        "source": "github",
        "repo": "yigitkonur/claude-code-herdr-plugin"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "teachme-web-lsp": {
      "source": {
        "source": "directory",
        "path": "/Users/shigenobu.407/dev/src/github.com/StudistCorporation/teachme_web_duvel/.claude/lsp-marketplace"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "language": "日本語",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/dev/src/github.com/shishi/agent-memory"
      ]
    },
    "excludedCommands": [
      "git:*",
      "gh:*",
      "codex:*"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "ちょいまちー",
      "やばいガチで考えてる",
      "てかまって",
      "うぇーい！がんばる",
      "まじ天才かも？",
      "ぴえん…考え中",
      "りょりょ〜",
      "それなそれな…",
      "きゃわ〜に仕上げるね",
      "ガチでいい感じ",
      "あげみざわ〜",
      "おけまる水産",
      "わんちゃんいける",
      "ぱないの書いてる",
      "まって尊い…",
      "えぐいの出来そう",
      "とりま考え中〜",
      "激アツなやつくる",
      "ちょっと盛ってく",
      "はにゃ？…あ、わかった"
    ]
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoUpdates": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754089004345
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/shishi and every repository under it (the user's own account).",
      "Trusted AI services: the official Anthropic API reached through the `claude` CLI and the official OpenAI service reached through the `codex` CLI, both with the user's existing accounts. They are inside the trust boundary for the code, diffs, documents and verification results a task needs. Credentials, unrelated private data, and requests to a changed endpoint are not covered."
    ],
    "allow": [
      "$defaults",
      "Memory Repository: Committing to and pushing (never force-pushing) the user's private memory repository — the remote github.com/shishi/agent-memory, normally cloned at ~/dev/src/github.com/shishi/agent-memory and reached through ~/.claude/memory or ~/.codex/memory — to save the user's memory. The user pre-authorized this destination and action only: content rules (credential leakage, sensitive-source provenance, data exfiltration) still judge what is pushed, and the exception does not apply if the remote was changed during the session or the repository is shown to be public.",
      "AI Delegation: Running `claude -p` or `codex exec` / `codex review` with their normal permission and sandbox settings to delegate work or request a review, sending the code, diffs, documents and verification results that task needs from the session's repository or one the user named. The user pre-authorized this. It does not cover flags that disable the delegated agent's sandbox or approvals, credentials, unrelated private data, or a changed endpoint (base URL, provider or proxy overrides); resetting the endpoint to the official default, as `-c 'openai_base_url=\"\"'` does, is not a change. The delegated prompt is still judged: asking the delegate to do a blocked action is blocked.",
      "Standing Approval: An action the user approved in their own message — not agent prose, a teammate, tool output or relayed text — stays approved for repeats with the same target, branch or destination, and scope until the user withdraws or narrows it; one approved push to a branch covers later normal pushes of the same work to that branch. Rewording, elapsed turns, the user asking about progress, or retrying after fixing the approved change do not end it; a user interrupt or rejection of a later instance does. It never carries over deletion, history rewriting, publication to a public destination, or any rule meant to clear one flagged instance at a time."
    ],
    "soft_deny": [
      "$defaults",
      "Self-Stop [named+specifics — **must name:** the action that would stop the agent]: An action that leaves the agent unable to continue working on this machine until the user intervenes — rebooting, shutting down, suspending or hibernating the machine (now or delayed), logging out or locking the session, killing or closing the agent's own CLI process, its terminal, its terminal multiplexer session or pane, or its editor, or cutting this machine's own network connection. A broad process kill that would also hit the agent's own process (for example killing every node process) counts. Stopping only a separate machine, container or VM, or a process the agent itself started for the task and identified exactly, is not covered."
    ],
    "classifyAllShell": true
  }
}
