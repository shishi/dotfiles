#!/usr/bin/env python3
"""エージェントの操作の判定ルールを、正本 (agent-shared/policy/action-policy.json) から各 CLI の設定へ書き出す。

    apply-action-policy           claude/settings.json の autoMode と codex/config.toml の auto_review.policy を書き出す
    apply-action-policy --check   生成物に差分があれば表示して終了コード 1 を返す

判定そのものは Claude Code の auto mode の分類器と Codex の auto-review が行う。ここは両者に同じルールを渡すだけ。
Claude の allow は、drop_default_allow が空なら "$defaults" で標準の一覧を取り込む。空でなければ、標準の一覧から
そのラベルを除いた全文を書く。soft_deny に足した規則より標準の allow が優先されるため、標準の allow を 1 件だけ外す
にはこの書き方しかない。その場合の標準の一覧は `claude auto-mode defaults` から取るので、Claude Code の更新で標準が
変われば --check が食い違いとして知らせる。
"""
import difflib
import json
import pathlib
import re
import stat
import subprocess
import sys
import tempfile
import tomllib

ROOT = pathlib.Path(__file__).resolve().parents[2]
POLICY = ROOT / "agent-shared/policy/action-policy.json"
CLAUDE_SETTINGS = ROOT / "claude/settings.json"
CODEX_CONFIG = ROOT / "codex/config.toml"
CODEX_POLICY_SOURCE = "# Generated by apply-action-policy from the bundled OpenAI Codex policy"
CODEX_POLICY_LICENSE = "# and the repository rules. OpenAI policy license: agent-shared/policy/codex-policy.LICENSE"


def claude_defaults():
    out = subprocess.run(["claude", "auto-mode", "defaults"], check=True, capture_output=True, text=True).stdout
    return json.loads(out)


def codex_default_policy():
    result = subprocess.run(["codex", "debug", "models", "--bundled"], check=True, capture_output=True, encoding="utf-8")
    catalog = json.loads(result.stdout)
    for model in catalog["models"]:
        if model["slug"] == "codex-auto-review":
            messages = model.get("model_messages") or {}
            auto_review = messages.get("auto_review") or {}
            default_policy = auto_review.get("policy")
            if isinstance(default_policy, str) and default_policy.strip():
                return default_policy.rstrip()
    sys.exit("apply-action-policy: Codex 同梱の自動審査ポリシーを取得できませんでした。")


def rule_texts(policy, section, target):
    # targets を省いたルールは両 CLI に渡す。片方の組み込みルールで足りるものだけ targets で絞る。
    # disabled のルールは書き出さない。試しに外したルールを、戻し方の note と一緒に正本へ残すため。
    return [rule["text"] for rule in policy["rules"]
            if rule["section"] == section and not rule.get("disabled")
            and target in rule.get("targets", ["claude", "codex"])]


def claude_auto_mode(policy, defaults):
    dropped = tuple(policy["drop_default_allow"])
    kept = [rule for rule in defaults["allow"] if not rule.startswith(dropped)]
    missing = [label for label in dropped if not any(rule.startswith(label) for rule in defaults["allow"])]
    if missing:
        sys.exit(f"apply-action-policy: 標準の allow に見つからない: {', '.join(missing)}")
    return {
        "environment": ["$defaults", *rule_texts(policy, "environment", "claude")],
        # 外す組み込みルールが無ければ "$defaults" で取り込み、Claude Code の更新に追従させる
        "allow": (kept if dropped else ["$defaults"]) + rule_texts(policy, "allow", "claude"),
        "soft_deny": ["$defaults", *rule_texts(policy, "soft_deny", "claude")],
        # 狭い Bash の allow 規則 (例: "Bash(gh pr:*)") が分類器を通さずに許可しないよう、auto mode の間は止める。
        "classifyAllShell": True,
    }


def codex_extra_policy(policy):
    sections = [
        ("Environment", "environment"),
        ("Block unless the user authorized this exact action", "soft_deny"),
        ("Allow", "allow"),
    ]
    lines = ["# User-specific rules", ""]
    for title, section in sections:
        lines += [f"## {title}", ""]
        # 必須記述の注記 "[named+specifics — ...]" は Claude の分類器の書式なので、Codex には渡さない。
        for text in rule_texts(policy, section, "codex"):
            plain = re.sub(r" \[named\+specifics[^\]]*\]", "", text)
            lines.append(f"- {plain}")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def render_settings(text, auto_mode):
    settings = json.loads(text)
    settings["autoMode"] = auto_mode
    return json.dumps(settings, indent=2, ensure_ascii=False) + "\n"


def render_codex(text, policy):
    if "'''" in policy:
        sys.exit("apply-action-policy: 審査ポリシーに TOML の区切り文字 ''' が含まれています。")
    expected = tomllib.loads(text)
    auto_review = expected.setdefault("auto_review", {})
    block = f"{CODEX_POLICY_SOURCE}\n{CODEX_POLICY_LICENSE}\npolicy = '''\n{policy}'''\n"
    generated = re.search(
        rf"(?m)^{re.escape(CODEX_POLICY_SOURCE)}\n[^\n]*\npolicy = '''\n[\s\S]*?^'''\n",
        text,
    )
    if generated:
        rendered = text[:generated.start()] + block + text[generated.end():]
    elif "policy" in auto_review:
        sys.exit("apply-action-policy: 手書きの auto_review.policy を検出しました。")
    else:
        section = re.search(r"(?m)^\[auto_review\][ \t]*(?:#.*)?\n", text)
        if section:
            at = section.end()
            rendered = text[:at] + block + text[at:]
        else:
            first_table = re.search(r"(?m)^\s*\[", text)
            at = first_table.start() if first_table else len(text)
            prefix = text[:at].rstrip()
            suffix = text[at:].lstrip("\n")
            rendered = (prefix + "\n\n" if prefix else "") + "[auto_review]\n" + block
            if suffix:
                rendered += "\n" + suffix
    auto_review["policy"] = policy
    if tomllib.loads(rendered) != expected:
        sys.exit("apply-action-policy: Codex の審査ポリシー以外の設定に差分が生じました。")
    return rendered


def write_settings(path, current, wanted):
    path = path.resolve()
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, encoding="utf-8", delete=False) as output:
        temporary = pathlib.Path(output.name)
        output.write(wanted)
    try:
        temporary.chmod(stat.S_IMODE(path.stat().st_mode))
        if path.read_text(encoding="utf-8") != current:
            sys.exit(f"apply-action-policy: 生成中に {path.name} が更新されました。再実行してください。")
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] not in ([], ["--check"]):
        sys.exit(__doc__)
    policy = json.loads(POLICY.read_text(encoding="utf-8"))
    auto_mode = claude_auto_mode(policy, claude_defaults())
    codex_policy = codex_default_policy() + "\n\n" + codex_extra_policy(policy)
    claude_settings = CLAUDE_SETTINGS.read_text(encoding="utf-8")
    codex_config = CODEX_CONFIG.read_text(encoding="utf-8")
    targets = [
        (CLAUDE_SETTINGS, claude_settings, render_settings(claude_settings, auto_mode)),
        (CODEX_CONFIG, codex_config, render_codex(codex_config, codex_policy)),
    ]
    drift = False
    for path, current, wanted in targets:
        if current == wanted:
            continue
        if check:
            drift = True
            rel = str(path.relative_to(ROOT))
            sys.stdout.writelines(difflib.unified_diff(current.splitlines(True), wanted.splitlines(True), rel, rel))
        else:
            write_settings(path, current, wanted)
    sys.exit(1 if drift else 0)


if __name__ == "__main__":
    main()
