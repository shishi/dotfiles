# シェルが生成する状態
/fish/fish_variables

# Claude Code
# マシンローカルの Claude Code 設定。追跡すると片方のマシンの許可が全マシンへ配られる。
/.claude/worktrees
/.claude/settings.local.json
/claude/*
!/claude/CLAUDE.md
!/claude/settings.json
!/claude/statusline.sh
!/claude/install-plugins.sh
!/claude/agents/
!/claude/agents/**
!/claude/hooks/
!/claude/hooks/**
!/claude/rules/
!/claude/rules/**
!/claude/skills/
!/claude/skills/**

# Codex
/.codex/worktrees
/codex/*
!/codex/AGENTS.md
!/codex/config.toml
!/codex/teachme-biz.config.toml
!/codex/g-dev.config.toml
!/codex/g-dev-design.config.toml
!/codex/g-dev-gokigen-super-express.config.toml
!/codex/g-dev-qa.config.toml
!/codex/auto-review-template.LICENSE
!/codex/hooks.json
!/codex/agents/
!/codex/agents/**
!/codex/hooks/
!/codex/hooks/**
!/codex/skills/
!/codex/skills/**
/codex/skills/.system/

# ツール自身が生成する skill の link
/claude/skills/terminal-browser
/codex/skills/terminal-browser

# herdr-skills.sh が端末の Herdr の CLI から生成する skill
/claude/skills/herdr-core/
/claude/skills/herdr-app/
/codex/skills/herdr-core/
/codex/skills/herdr-app/

# 言語処理系が生成する一時ファイル
__pycache__/
*.py[co]

# 作業用ディレクトリ
/.worktrees/
/docs/superpowers/*

# BEGIN managed external skills
/claude/skills/grilling/
/codex/skills/grilling/
# END managed external skills
