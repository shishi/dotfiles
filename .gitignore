# シェルが生成する状態
/fish/fish_variables

# Claude Code
# マシンローカルの Claude Code 設定。追跡すると片方のマシンの許可が全マシンへ配られる。
/.claude/worktrees
/.claude/settings.local.json
/claude/*
!/claude/CLAUDE.md
!/claude/settings.json
!/claude/statusline.sh
!/claude/install-plugins.sh
!/claude/mods/
!/claude/mods/**
# mod を読み込んだ Claude Code が書く型定義。
/claude/mods/*/.claude-plugin/types/
!/claude/agents/
!/claude/agents/**
!/claude/hooks/
!/claude/hooks/**
# Herdr が Windows 用に生成・更新する runtime hook。POSIX 用 .sh は追跡する。
/claude/hooks/herdr-agent-state.ps1
!/claude/rules/
!/claude/rules/**
!/claude/skills/
!/claude/skills/**

# Codex
/.codex/worktrees
/codex/*
!/codex/AGENTS.md
!/codex/config.toml
!/codex/auto-review-template.LICENSE
!/codex/hooks.json
!/codex/agents/
!/codex/agents/**
!/codex/hooks/
!/codex/hooks/**
!/codex/skills/
!/codex/skills/**
/codex/skills/.system/

# ツール自身が生成する skill の link
/claude/skills/terminal-browser
/codex/skills/terminal-browser

# 言語処理系が生成する一時ファイル
__pycache__/
*.py[co]

# 作業用ディレクトリ
/.worktrees/
/docs/superpowers/*

# BEGIN managed external skills
/claude/skills/grilling/
/codex/skills/grilling/
# END managed external skills
