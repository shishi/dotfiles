/fish/fish_variables
# マシンローカルの Claude Code 設定。追跡すると片方のマシンの許可が全マシンへ配られる。
/.claude/settings.local.json
/claude/*
!/claude/CLAUDE.md
!/claude/settings.json
!/claude/rules/
!/claude/rules/**
!/claude/agents/
!/claude/agents/**
!/claude/hooks/
!/claude/hooks/**
# Herdr が Windows 用に生成・更新する runtime hook。POSIX 用 .sh は追跡する。
/claude/hooks/herdr-agent-state.ps1
!/claude/skills/
!/claude/skills/**
/claude/skills/hunk-review/
!/claude/statusline.sh
!/claude/install-plugins.sh
/codex/*
!/codex/AGENTS.md
!/codex/config.toml
!/codex/agents/
!/codex/agents/**
!/codex/rules/
!/codex/rules/**
!/codex/skills/
!/codex/skills/**
/codex/skills/hunk-review/
/codex/skills/.system/
!/codex/hooks/
!/codex/hooks/**
!/codex/hooks.json
__pycache__/
*.py[co]
/.worktrees/

/docs/superpowers/*
